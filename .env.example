# DMARCscope configuration. Copy to .env.local for local development, or set
# these as environment variables / secrets in your deployment platform.
# Full reference: docs/configuration.md
#
# Only DATABASE_URL, APP_URL and APP_SECRET are needed to start: leave
# AUTH_PROVIDER unset and the app serves its setup wizard (/setup), and much
# of the rest can then be set in the browser. A variable that is set here
# always wins over the browser ("managed by environment").
#
# Comments go on their own lines: `docker run --env-file` and Kubernetes
# secrets take everything after "=" literally, including a trailing "# note".

# ---------------------------------------------------------------- Database
# Any PostgreSQL 13+ (UTF-8). Add ?sslmode=require for managed databases.
# Used by the web app, the ingest worker and `npm run db:migrate`.
DATABASE_URL=postgresql://dmarcscope:dmarcscope@localhost:5432/dmarcscope
# DATABASE_POOL_MAX=10
# Abandon a query after this long (milliseconds; 0 disables).
# DATABASE_QUERY_TIMEOUT_MS=30000
# Also enforce a limit in the database. Not accepted by transaction-mode
# poolers; there, use ALTER ROLE ... SET statement_timeout instead.
# DATABASE_STATEMENT_TIMEOUT_MS=30000

# ------------------------------------------------------------------ Web app
# Public URL of the dashboard. Required in production.
APP_URL=http://localhost:3000
# APP_NAME=DMARCscope

# Encrypts secrets saved in the browser (and the owner's authenticator seed),
# and sessions when SESSION_SECRET is not set. At least 32 random characters:
#   openssl rand -base64 32
# Keep it in a secret manager and back it up: without it, secrets saved in
# the browser cannot be read. To rotate, see docs/configuration.md.
# APP_SECRET=
# APP_SECRET_PREVIOUS=

# Unlocks the setup wizard instead of the one-time token the app prints to
# its log on first start (at least 24 characters).
# SETUP_TOKEN=
# Seconds each instance trusts its copy of the settings saved in the browser.
# SETTINGS_CACHE_SECONDS=5
# Header your reverse proxy puts the client address in (for sign-in rate
# limits and the audit log); for x-forwarded-for the last entry is used.
# CLIENT_IP_HEADER=x-forwarded-for

# ----------------------------------------------------------- Authentication
# Unset: sign-in is managed in the app (setup wizard, owner password + TOTP).
# Or one of: oidc | proxy-jwt | proxy-header | none      (docs/authentication.md)
#   oidc          built-in sign-in with any OpenID Connect provider
#   proxy-jwt     signed identity header from Google Cloud IAP, Cloudflare Access, ...
#   proxy-header  plain identity header from oauth2-proxy, nginx auth_request, ...
#   none          no sign-in at all; local development only
AUTH_PROVIDER=none
# "none" is refused when NODE_ENV=production (as in the container image)
# unless this is set. Only for demos, or when access is enforced elsewhere.
# AUTH_ALLOW_INSECURE_NONE=true

# --- oidc
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Redirect URI to register with the provider: <APP_URL>/auth/callback
# Encrypts the session cookie. Optional when APP_SECRET is set; existing
# deployments keep theirs. Generate with: openssl rand -base64 32
# SESSION_SECRET=
# How long a sign-in lasts (1-168). Also the longest a removal at the
# identity provider can take to reach this app.
# SESSION_MAX_AGE_HOURS=12
# Reject sessions issued before this moment (signs those users out).
# SESSION_NOT_BEFORE=2026-01-31T09:00:00Z
# Claims the ID token must carry, e.g. Google Workspace domain or Entra tenant.
# Needed whenever the provider also serves accounts outside your organization.
# OIDC_REQUIRED_CLAIMS=hd=example.com
# Button label: "Sign in with Google"
# OIDC_PROVIDER_NAME=Google
# OIDC_SCOPES=openid email profile
# OIDC_GROUPS_CLAIM=groups
# Claim holding the user's address. Entra ID: preferred_username.
# OIDC_EMAIL_CLAIM=email
# Accept an `email` claim the provider has not marked email_verified=true.
# OIDC_ALLOW_UNVERIFIED_EMAIL=false
# OIDC_PROMPT=select_account
# Also end the session at the provider on sign-out.
# OIDC_LOGOUT_AT_IDP=false
# Local test providers only: allow an http:// issuer.
# OIDC_ALLOW_INSECURE_ISSUER=false

# --- proxy-jwt
# gcp-iap or cloudflare-access; omit for a custom proxy.
# AUTH_PROXY_PRESET=gcp-iap
# AUTH_PROXY_AUDIENCE=/projects/PROJECT_NUMBER/global/backendServices/SERVICE_ID
# cloudflare-access and custom proxies:
# AUTH_PROXY_ISSUER=https://<team>.cloudflareaccess.com
# Custom proxies only:
# AUTH_PROXY_JWT_HEADER=
# AUTH_PROXY_JWKS_URL=
# AUTH_PROXY_EMAIL_CLAIM=email
# AUTH_PROXY_GROUPS_CLAIM=groups
# Local test proxies only: allow an http:// JWKS URL.
# AUTH_PROXY_ALLOW_INSECURE_JWKS=false

# --- proxy-header
# AUTH_PROXY_EMAIL_HEADER=x-forwarded-email
# AUTH_PROXY_GROUPS_HEADER=x-forwarded-groups
# AUTH_PROXY_NAME_HEADER=x-forwarded-preferred-username
# A secret your proxy adds to every request (header x-proxy-secret), so that
# requests bypassing the proxy are rejected. Strongly recommended.
# AUTH_PROXY_SHARED_SECRET=
# AUTH_PROXY_SECRET_HEADER=x-proxy-secret
# Alternative: confirm the app is only reachable through the proxy.
# AUTH_PROXY_TRUST_NETWORK=false

# ------------------------------------------------------------ Authorization
# Access is denied by default: signing in is not enough, a person must match
# one of these (or a rule saved in the database). All are comma-separated and
# case-insensitive. Admins can run DNS checks and are implicitly viewers.
# `npm run settings:import` copies these into the database, after which they
# can be removed from here.
ADMIN_EMAILS=
ADMIN_GROUPS=
ALLOWED_EMAILS=
ALLOWED_EMAIL_DOMAINS=
ALLOWED_GROUPS=
# Let everyone the identity provider authenticates view the dashboard. Only
# sensible when the provider itself is restricted to your organization.
# AUTH_ALLOW_ANY_AUTHENTICATED=false

# ------------------------------------------------------- Machine endpoints
# Bearer token for /api/cron/* (scheduled DNS checks; on Vercel also the
# ingest function). At least 16 characters. Can also be set by the owner in
# the browser. Endpoints refuse all requests while neither is set.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ------------------------------------------------------------ Ingest worker
# The mailbox that your domains' DMARC records send aggregate reports to.
IMAP_HOST=
IMAP_PORT=993
# ssl (implicit TLS) or starttls
IMAP_SECURITY=ssl
IMAP_USER=
IMAP_PASSWORD=
# IMAP_FOLDER=INBOX
# Move stored reports here (default: leave in place, marked as read).
# IMAP_PROCESSED_FOLDER=
# Messages that are not DMARC reports are moved here.
# IMAP_INVALID_FOLDER=DMARC-Invalid

# The domains you monitor (comma-separated). Reports about any other domain
# are ignored. Set this in production: anyone can email a "report" about any
# domain to your mailbox, and without it that domain appears on the dashboard.
# (Not to be confused with ALLOWED_EMAIL_DOMAINS above, which is about people.)
ALLOWED_DOMAINS=

# Retention. Reports older than this are deleted on each run (and never
# fetched). Use either or both; unset keeps everything.
# RETENTION_DAYS=400
# INGEST_MIN_DATE=2026-01-01

# INGEST_MAX_MESSAGES=2000
# INGEST_TIME_BUDGET_SECONDS=600
# INGEST_ENRICH_BUDGET_SECONDS=60

# Web app: warn on the dashboard, and answer 503 on /api/cron/status, when no
# ingest run has completed for this long.
# INGEST_STALE_HOURS=36

# ----------------------------------------------------------- Docker Compose
# Read by docker-compose.yml only.
# POSTGRES_PASSWORD=
# Where the dashboard is published on the host (default 127.0.0.1:3000).
# WEB_BIND=127.0.0.1
# WEB_PORT=3000
