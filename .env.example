# DMARCscope configuration. Copy to .env.local for local development, or set
# these as environment variables / secrets in your deployment platform.
# Full reference: docs/configuration.md

# ---------------------------------------------------------------- Database
# Any PostgreSQL 13+ (UTF-8). Add ?sslmode=require for managed databases.
# Used by the web app, the ingest worker and `npm run db:migrate`.
DATABASE_URL=postgresql://dmarcscope:dmarcscope@localhost:5432/dmarcscope
# DATABASE_POOL_MAX=5

# ------------------------------------------------------------------ Web app
# Public URL of the dashboard. Required in production.
APP_URL=http://localhost:3000
# APP_NAME=DMARCscope

# ----------------------------------------------------------- Authentication
# One of: oidc | proxy-jwt | proxy-header | none      (docs/authentication.md)
#   oidc          built-in sign-in with any OpenID Connect provider
#   proxy-jwt     signed identity header from Google Cloud IAP, Cloudflare Access, ...
#   proxy-header  plain identity header from oauth2-proxy, nginx auth_request, ...
#   none          no sign-in at all; local development only
AUTH_PROVIDER=none

# --- oidc
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Redirect URI to register with the provider: <APP_URL>/auth/callback
# Encrypts the session cookie. Generate with: openssl rand -base64 32
# SESSION_SECRET=
# SESSION_MAX_AGE_HOURS=12
# OIDC_PROVIDER_NAME=Google          # button label: "Sign in with Google"
# OIDC_SCOPES=openid email profile
# OIDC_GROUPS_CLAIM=groups
# OIDC_EMAIL_CLAIM=email
# OIDC_PROMPT=select_account
# OIDC_LOGOUT_AT_IDP=false           # also end the session at the provider on sign-out

# --- proxy-jwt
# AUTH_PROXY_PRESET=gcp-iap          # or cloudflare-access; omit for a custom proxy
# AUTH_PROXY_AUDIENCE=/projects/PROJECT_NUMBER/global/backendServices/SERVICE_ID
# AUTH_PROXY_ISSUER=https://<team>.cloudflareaccess.com   # cloudflare-access / custom
# AUTH_PROXY_JWT_HEADER=             # custom only
# AUTH_PROXY_JWKS_URL=               # custom only
# AUTH_PROXY_EMAIL_CLAIM=email
# AUTH_PROXY_GROUPS_CLAIM=groups

# --- proxy-header
# AUTH_PROXY_EMAIL_HEADER=x-forwarded-email
# AUTH_PROXY_GROUPS_HEADER=x-forwarded-groups
# A secret your proxy adds to every request (header x-proxy-secret), so that
# requests bypassing the proxy are rejected. Strongly recommended.
# AUTH_PROXY_SHARED_SECRET=
# AUTH_PROXY_SECRET_HEADER=x-proxy-secret
# Alternative: confirm the app is only reachable through the proxy.
# AUTH_PROXY_TRUST_NETWORK=false

# ------------------------------------------------------------ Authorization
# Access is denied by default: signing in is not enough, a person must match
# one of these. All are comma-separated and case-insensitive.
# Admins can run DNS checks and are implicitly viewers.
ADMIN_EMAILS=
ADMIN_GROUPS=
ALLOWED_EMAILS=
ALLOWED_EMAIL_DOMAINS=
ALLOWED_GROUPS=
# Let everyone the identity provider authenticates view the dashboard. Only
# sensible when the provider itself is restricted to your organization.
# AUTH_ALLOW_ANY_AUTHENTICATED=false

# ------------------------------------------------------- Machine endpoints
# Bearer token for /api/cron/* (scheduled DNS checks; on Vercel also the
# ingest function). At least 16 characters. Endpoints refuse all requests
# while it is unset. Generate with: openssl rand -hex 32
CRON_SECRET=

# ------------------------------------------------------------ Ingest worker
# The mailbox that your domains' DMARC records send aggregate reports to.
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURITY=ssl                  # ssl (implicit TLS) or starttls
IMAP_USER=
IMAP_PASSWORD=
# IMAP_FOLDER=INBOX
# Move stored reports here (default: leave in place, marked as read).
# IMAP_PROCESSED_FOLDER=
# Messages that are not DMARC reports are moved here.
# IMAP_INVALID_FOLDER=DMARC-Invalid

# Only store reports for these domains. Recommended: anyone can email a
# "report" about any domain to your mailbox.
ALLOWED_DOMAINS=

# Retention. Reports older than this are deleted on each run (and never
# fetched). Use either or both; unset keeps everything.
# RETENTION_DAYS=400
# INGEST_MIN_DATE=2026-01-01

# INGEST_MAX_MESSAGES=2000
# INGEST_TIME_BUDGET_SECONDS=600
# INGEST_ENRICH_BUDGET_SECONDS=60
